---
// PLACEHOLDER copy — replace with real, verifiable testimonials before launch
// (see README "Owner TODOs"). Do not treat these as live reviews or ratings.
const reviews = [
  { body: 'Driver was waiting with my name despite a delay. Prepaid the $50 airport-hotel rate, easy ride to Wyndham Quito Airport in a luxury SUV.', loc: 'United States' },
  { body: 'Booked the $100 city rate to Swissôtel, paid up front, and skipped the taxi negotiation after a late landing. Licensed driver, clear price.', loc: 'Canada' },
  { body: 'Family of four to Casa Gangotena. Luxury SUV had the bags, child seat was ready, and the prepaid rate was exactly what we paid.', loc: 'United Kingdom' },
];
---
<section id="reviews">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Sample arrival notes</span>
      <h2 class="section-title">A prepaid SUV, a licensed driver, a name sign</h2>
      <p class="lede">Illustrative copy only — not customer reviews. We will replace these with verified guest quotes before launch.</p>
    </div>
    <div class="rev-grid">
      {reviews.map((r) => (
        <div class="rev reveal">
          <span class="sample-badge">Sample copy</span>
          <p>{r.body}</p>
          <div class="who">
            <div class="loc">Example · {r.loc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
