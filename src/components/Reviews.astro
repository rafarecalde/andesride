---
import { SITE } from '../config';
// PLACEHOLDER reviews — replace with real, verifiable testimonials before launch
// (see README "Owner TODOs"). Keep the count/rating in sync with src/config.ts.
const reviews = [
  { stars: 5, body: 'Driver was waiting with my name despite a 2-hour delay. Fixed price, spotless SUV, easy ride to Cumbayá. Booked the return on the spot.', initials: 'SK', name: 'Sarah K.', loc: 'United States' },
  { stars: 5, body: 'So much less stressful than figuring out a taxi at midnight. Paid online, got a confirmation, driver texted on WhatsApp. Exactly as promised.', initials: 'MR', name: 'Marc R.', loc: 'Canada' },
  { stars: 5, body: 'Used the van for our family of six to Otavalo. Flat rate was fair and clear up front. Professional, on time, English-speaking driver.', initials: 'JL', name: 'Julia L.', loc: 'United Kingdom' },
];
---
<section id="reviews">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">★★★★★ {SITE.ratingValue} / 5</span><h2 class="section-title">Travelers land relaxed</h2></div>
    <div class="rev-grid">
      {reviews.map((r) => (
        <div class="rev reveal">
          <div class="stars" style="color:var(--amber)" aria-label={`${r.stars} out of 5`}>★★★★★</div>
          <p>{r.body}</p>
          <div class="who">
            <div class="av">{r.initials}</div>
            <div><div class="nm">{r.name}</div><div class="loc">{r.loc}</div></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
