---
const items = [
  { t: 'Prepaid flat rate', p: 'Pay up front in USD. The price you see is the price you pay — no meter, no surge, no late-night surcharge.', icon: '<path d="M12 2l8 4v6c0 4-3 7-8 9-5-2-8-5-8-9V6z"/><path d="M9 12l2 2 4-4"/>' },
  { t: 'Flight tracking included', p: 'We watch your flight and adjust pickup automatically. Delayed? Your driver still waits, free.', icon: '<path d="M16 3h5v5M21 3l-9 9M8 21H3v-5M3 21l9-9"/>' },
  { t: 'Licensed, vetted drivers', p: 'Airport-authorized, insured, background-checked drivers who know Quito — many speak English.', icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0114 0"/>' },
  { t: 'Meet & greet', p: 'Your driver waits at arrivals with a name sign and helps with your bags. No hunting for a taxi.', icon: '<path d="M4 7h16v12H4z"/><path d="M4 7l8 6 8-6"/>' },
  { t: '24/7 service', p: 'Early flight or a 2 a.m. landing — we run around the clock, every day of the year.', icon: '<path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/>' },
  { t: 'Free cancellation', p: 'Plans change. Cancel up to 24 hours before pickup for a full refund, no questions.', icon: '<path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 11-6.2-8.6"/>' },
];
---
<section id="why">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Why book with us</span><h2 class="section-title">The reliable way to and from UIO</h2></div>
    <div class="why-grid">
      {items.map((i) => (
        <div class="why reveal">
          <div class="ic"><svg viewBox="0 0 24 24" set:html={i.icon} /></div>
          <h3>{i.t}</h3>
          <p>{i.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>
