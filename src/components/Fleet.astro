---
import { Picture } from 'astro:assets';
import rates from '../data/rates.json';
import { getPhoto } from '../lib/photos';

const suvPhoto = getPhoto('suv');

const { vehicles, zones } = rates;
const fromPrice = Math.min(...zones.map((z) => z.price));
---
<section id="fleet" class="alt">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">The vehicle</span>
      <h2 class="section-title">Luxury SUV and a licensed driver</h2>
      <p class="lede">Every prepaid transfer is the same product: a luxury SUV with a licensed, airport-authorized driver. Sedans and vans are not on the booking path.</p>
    </div>
    <div class={`fleet${vehicles.length === 1 ? ' solo' : ''}`}>
      {vehicles.map((v) => {
        return (
          <div class="fc reveal">
            <figure class="fimg">
              <Picture
                src={suvPhoto.src}
                alt={suvPhoto.alt}
                formats={['avif', 'webp']}
                quality={68}
                widths={[640, 960, 1400]}
                sizes="(min-width: 980px) 60vw, 100vw"
                loading="lazy"
              />
            </figure>
            <div class="fc-copy">
              <h3>{v.name}</h3>
              <div class="cap">Up to {v.maxPax} passengers · {v.bags} bags · licensed driver</div>
              <div class="from">From <b>${fromPrice}</b> prepaid, one-way</div>
              <div class="repnote">Parties of 5–8 book a second SUV at the same prepaid rate × 2.</div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
