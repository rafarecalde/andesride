---
import { Image } from 'astro:assets';
import { u } from '../lib/url';
import { heroPhoto } from '../lib/hero';
import Booker from './Booker.astro';
---
<section class:list={['hero', heroPhoto && 'has-photo']} id="top">
  <div class="hero-bg" aria-hidden="true">
    {heroPhoto
      ? <Image src={heroPhoto} alt="" width={1600} height={900} sizes="100vw" loading="eager" fetchpriority="high" />
      : <img src={u('/hero-quito-placeholder.svg')} alt="" />}
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Quito Airport Transfer · UIO</span>
        <h1>Prepaid luxury SUV from UIO — <span class="hl">$50</span> or <span class="hl">$100</span></h1>
        <p class="hero-sub">A licensed driver in a luxury SUV. Pay the flat rate up front: $50 to Wyndham Quito Airport, $100 anywhere in Quito city — including Hyatt, Oro Verde, Swissôtel, and Casa Gangotena.</p>
        <div class="hero-prices" aria-label="Prepaid flat rates">
          <div class="hp"><b>$50</b><span>Wyndham Quito Airport</span></div>
          <div class="hp"><b>$100</b><span>Anywhere in Quito</span></div>
        </div>
        <div class="hero-usps">
          <div class="usp"><span class="ic"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> Prepaid flat rate in USD — no meter, no surprises</div>
          <div class="usp"><span class="ic"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> Luxury SUV with a licensed, airport-authorized driver</div>
          <div class="usp"><span class="ic"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> We track your flight — wait time included if you're delayed</div>
          <div class="usp"><span class="ic"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> Meet &amp; greet at arrivals with a name sign, included</div>
        </div>
      </div>

      <Booker />
    </div>
  </div>
</section>
