---
import rates from '../data/rates.json';
import { meetGreetPhoto } from '../lib/photos';
import Booker from './Booker.astro';

const { zones } = rates;
---
<section class="hero" id="top">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Quito Airport Transfer · UIO</span>
        <h1>Prepaid luxury SUV from UIO</h1>
        <p class="hero-sub">Three flat rates from Mariscal Sucre. Licensed driver. Pay in USD before you land.</p>
        <div class="hero-prices" aria-label="Prepaid flat rates">
          {zones.map((z) => (
            <div class="hp">
              <b>${z.price}</b>
              <div class="hp-txt">
                <span class="hp-name">{z.name}</span>
                <span class="hp-sub">{z.sub} · {z.eta}</span>
                {z.key === 'quito' && z.examples?.length ? (
                  <span class="hp-ex">{z.examples.join(' · ')}</span>
                ) : null}
              </div>
            </div>
          ))}
        </div>
        <ul class="hero-trust">
          <li>Licensed driver</li>
          <li>Prepaid in USD</li>
          <li>Flight tracking</li>
        </ul>
        {meetGreetPhoto ? (
          <figure class="hero-meet">
            <img
              src={meetGreetPhoto.src}
              alt="Licensed chauffeur at UIO arrivals holding a name-sign tablet for Sra. Martínez"
              width={meetGreetPhoto.width}
              height={meetGreetPhoto.height}
              decoding="async"
              fetchpriority="high"
            />
            <figcaption>Name-sign meet &amp; greet at UIO arrivals. Your driver is waiting when you land.</figcaption>
          </figure>
        ) : null}
      </div>

      <Booker />
    </div>
  </div>
</section>
