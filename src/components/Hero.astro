---
import { Picture } from 'astro:assets';
import rates from '../data/rates.json';
import { getPhoto } from '../lib/photos';
import Booker from './Booker.astro';
import PhotoCredit from './PhotoCredit.astro';

const place = getPhoto('uio');

const { zones } = rates;
---
<section class="hero" id="top">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Quito Airport Transfer · UIO</span>
        <h1>Prepaid luxury SUV from UIO</h1>
        <p class="hero-sub">Three flat rates from Mariscal Sucre. Licensed driver. Pay in USD before you land.</p>
        <div class="hero-prices" aria-label="Prepaid flat rates">
          {zones.map((z) => (
            <div class="hp">
              <b>${z.price}</b>
              <div class="hp-txt">
                <span class="hp-name">{z.name}</span>
                <span class="hp-sub">{z.sub} · {z.eta}</span>
                {z.key === 'quito' && z.examples?.length ? (
                  <span class="hp-ex">{z.examples.join(' · ')}</span>
                ) : null}
              </div>
            </div>
          ))}
        </div>
        <ul class="hero-trust">
          <li>Licensed driver</li>
          <li>Prepaid in USD</li>
          <li>Flight tracking</li>
        </ul>
      </div>

      <figure class="hero-meet">
        <Picture
          src={place.src}
          alt={place.alt}
          formats={['avif', 'webp']}
          quality={68}
          widths={[640, 960, 1400]}
          sizes="(min-width: 980px) 640px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          Mariscal Sucre International Airport (UIO), Tababela.
          <PhotoCredit id="uio" />
        </figcaption>
      </figure>

      <Booker />
    </div>
  </div>
</section>
