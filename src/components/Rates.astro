---
import rates from '../data/rates.json';
import { cumbayaValleyPhoto } from '../lib/photos';
const { zones, vehicles } = rates;
const suv = vehicles[0];
---
<section id="rates" class="alt">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Prepaid flat rates</span>
      <h2 class="section-title">Quito airport transfer prices (UIO)</h2>
      <p class="lede">Three prepaid luxury-SUV rates, in USD, paid up front. One-way airport pickups are the product — no meter, no surge, no airport surcharge.</p>
    </div>
    <div class="rate-board">
      {zones.map((z) => (
        <article class={`rate-row${z.key === 'cumbaya' && cumbayaValleyPhoto ? ' has-media' : ''}`}>
          {z.key === 'cumbaya' && cumbayaValleyPhoto ? (
            <figure class="rate-photo">
              <img
                src={cumbayaValleyPhoto.src}
                alt="Cumbayá valley — prepaid $75 transfer from UIO"
                width={cumbayaValleyPhoto.width}
                height={cumbayaValleyPhoto.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption>Anywhere in Cumbayá · Valle de Tumbaco</figcaption>
            </figure>
          ) : null}
          <div class="rate-copy">
            <div class="rate-card-kicker">{z.sub}</div>
            <h3>{z.name}</h3>
            <p class="rate-card-meta">{suv.name} · licensed driver · {z.eta}</p>
            {z.examples?.length ? (
              <ul class="hotel-list">
                {z.examples.map((h) => <li>{h}</li>)}
              </ul>
            ) : null}
            {z.note ? <p class="rate-card-note">{z.note}</p> : null}
          </div>
          <div class="rate-aside">
            <div class="rate-card-price">${z.price} <small>USD · one-way</small></div>
            <button type="button" class="btn btn-amber book" data-zone={z.key}>Book this rate</button>
          </div>
        </article>
      ))}
    </div>
    <div class="rates-note">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
      Round trips are twice the one-way rate. Child seats and extra stops are added at checkout. Destinations beyond these three products — Mitad del Mundo, Otavalo, Mindo, Papallacta — are quoted on request.
    </div>
  </div>
</section>

<script>
  // Prefill the booking widget from a rates-card "Book" button.
  document.querySelectorAll<HTMLButtonElement>('#rates .book').forEach((b) =>
    b.addEventListener('click', () => {
      const z = b.dataset.zone;
      if (z && (window as any).andesPrefill) (window as any).andesPrefill(z);
    }),
  );
</script>
