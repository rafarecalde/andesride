---
import rates from '../data/rates.json';
import { SITE, DISCLOSURE } from '../config';
import { imageFor, REPRESENTATIVE_CAPTION } from '../lib/fleet';
import { Image } from 'astro:assets';

const { zones, vehicles, extras } = rates;
const isLive = SITE.paymentsMode === 'live';
const suv = vehicles[0];
// Hard product cap: SUV seats 4 passengers (driver is the 5th occupant).
const MAX_PAX = 4;
const paxChoices = Math.min(suv.maxPax, MAX_PAX);

// Data handed to the client script — the widget reads rates from here, never
// from hardcoded values (single source of truth = rates.json).
const widgetData = JSON.stringify({ zones, vehicles, extras, minLeadDays: SITE.minLeadDays, maxPax: paxChoices });

const vehIcons: Record<string, string> = {
  suv: '<path d="M3 14l1.5-6A3 3 0 017.4 6h9.2a3 3 0 012.9 2L21 14"/><path d="M2 14h20v5H2zM6 19v2M18 19v2"/><circle cx="7" cy="14" r="1.5"/><circle cx="17" cy="14" r="1.5"/>',
};
---
<div class="booker" id="book">
  <div class="bk-head">
    <div class="h-l">
      <svg viewBox="0 0 24 24"><path d="M3 16l6-2 5-9 2 1-2 8 5-1 1 2-16 5z"/></svg>
      <span class="ti" id="bkTitle">Reserve your transfer</span>
    </div>
    <div class="bk-steps"><i class="on" id="dot0"></i><i id="dot1"></i><i id="dot2"></i></div>
  </div>
  <div class="bk-body">

    <!-- STEP 1: TRIP -->
    <div class="step on" id="step0">
      <div class="seg" role="group" aria-label="Direction">
        <button type="button" class="on" data-dir="from"><svg viewBox="0 0 24 24"><path d="M2 12h16M12 5l7 7-7 7"/><path d="M21 4v16"/></svg> From UIO</button>
        <button type="button" data-dir="to"><svg viewBox="0 0 24 24"><path d="M22 12H6M12 5l-7 7 7 7"/><path d="M3 4v16"/></svg> To UIO</button>
      </div>

      <div class="fld">
        <label id="zoneLabel" for="zone">Drop-off (prepaid luxury SUV)</label>
        <select class="ctrl" id="zone">
          <option value="" disabled selected>Choose your destination…</option>
          {zones.map((z) => <option value={z.key}>{z.name} — ${z.price}</option>)}
        </select>
        <div class="route-hint"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> <span id="etaHint">$50 airport hotel · $75 anywhere in Cumbayá · $100 anywhere in Quito</span></div>
        <div class="hotel-hint" id="hotelHint" hidden></div>
      </div>

      <div class="fld-row">
        <div class="fld"><label for="date">Pick-up date</label><input class="ctrl" type="date" id="date" required></div>
        <div class="fld"><label for="time">Pick-up time</label><input class="ctrl" type="time" id="time" value="09:00"></div>
      </div>
      <p class="date-hint" id="dateHint">We book at least 3 days ahead so your driver is confirmed.</p>
      <div class="fld"><label for="pax">Passengers</label>
        <select class="ctrl" id="pax">
          {Array.from({ length: paxChoices }, (_, i) => i + 1).map((n) => <option value={n} selected={n === 2}>{n}</option>)}
        </select>
      </div>
      <p class="date-hint" id="paxHint">This vehicle seats 4 passengers.</p>

      <label style="font-size:.72rem;letter-spacing:.04em;text-transform:uppercase;color:var(--slate);font-weight:600;margin-bottom:6px;display:block">Your vehicle</label>
      <div class="veh" id="veh">
        {vehicles.map((v) => {
          const photo = imageFor(v.key);
          return (
            <div class="veh-opt sel solo" data-veh={v.key}>
              <span class="vi">
                {photo
                  ? <Image src={photo} alt={`${v.name} — representative vehicle`} width={104} height={80} quality={80} />
                  : <svg viewBox="0 0 24 24" set:html={vehIcons[v.key] || vehIcons.suv} />}
              </span>
              <span class="vmid"><span class="vn">{v.name}</span><span class="vmeta">Licensed driver · up to {v.maxPax} passengers · {v.bags} bags</span></span>
              <span class="vp"><span id={`p-${v.key}`}>$—</span><small>prepaid</small></span>
            </div>
          );
        })}
      </div>
      <div class="veh-cap">{REPRESENTATIVE_CAPTION}</div>

      <div class="total-bar">
        <div class="tl">Total <b id="t0">$—</b></div>
        <div class="tg"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg> Prepaid flat rate</div>
      </div>
      <button class="btn btn-amber" style="width:100%" id="toStep1">Continue</button>
    </div>

    <!-- STEP 2: EXTRAS + DETAILS -->
    <div class="step" id="step1">
      <div class="xtras" style="margin-bottom:16px">
        <div class="xtra">
          <span class="xi"><svg viewBox="0 0 24 24"><path d="M3 7h6l3 3 3-3h6"/><path d="M7 7v10M17 7v10"/></svg></span>
          <span class="xt"><span class="xn">Round trip</span><span class="xd">Return ride at the same prepaid rate</span></span>
          <label class="switch"><input type="checkbox" id="rt" aria-label="Round trip"><span class="sl"></span></label>
        </div>
        <div id="rtFields" style="display:none">
          <div class="fld-row">
            <div class="fld"><label for="rdate">Return date</label><input class="ctrl" type="date" id="rdate"></div>
            <div class="fld"><label for="rtime">Return time</label><input class="ctrl" type="time" id="rtime" value="09:00"></div>
          </div>
        </div>
        <div class="xtra">
          <span class="xi"><svg viewBox="0 0 24 24"><rect x="6" y="9" width="12" height="10" rx="2"/><path d="M9 9V6h6v3"/></svg></span>
          <span class="xt"><span class="xn">Child seat</span><span class="xd">${extras.childSeat} each</span></span>
          <span class="qty"><button type="button" id="childMinus" aria-label="Fewer child seats">−</button><span id="childN">0</span><button type="button" id="childPlus" aria-label="More child seats">+</button></span>
        </div>
        <div class="xtra">
          <span class="xi"><svg viewBox="0 0 24 24"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 00-8 8c0 5 8 12 8 12s8-7 8-12a8 8 0 00-8-8z"/></svg></span>
          <span class="xt"><span class="xn">Extra stop</span><span class="xd">One additional pickup or stop · ${extras.extraStop}</span></span>
          <label class="switch"><input type="checkbox" id="stop" aria-label="Extra stop"><span class="sl"></span></label>
        </div>
        <div class="xtra">
          <span class="xi"><svg viewBox="0 0 24 24"><path d="M16 3h5v5M21 3l-7 7M8 21H3v-5M3 21l7-7"/></svg></span>
          <span class="xt"><span class="xn">Meet &amp; greet + flight tracking</span><span class="xd">Driver waits at arrivals with a name sign</span></span>
          <span class="xp free">Included</span>
        </div>
      </div>

      <div class="fld"><label for="flight">Flight number <span style="color:var(--slate-light);text-transform:none;letter-spacing:0">(so we track your arrival)</span></label><input class="ctrl" id="flight" placeholder="e.g. AV 0918"></div>
      <div class="fld"><label for="name">Lead passenger name</label><input class="ctrl" id="name" placeholder="Full name" autocomplete="name"></div>
      <div class="fld-row">
        <div class="fld"><label for="email">Email</label><input class="ctrl" type="email" id="email" placeholder="you@email.com" autocomplete="email"></div>
        <div class="fld"><label for="phone">Mobile / WhatsApp</label><input class="ctrl" id="phone" placeholder="+1 305 …" autocomplete="tel"></div>
      </div>

      <p class="disclosure">{DISCLOSURE}</p>

      <div class="total-bar"><div class="tl">Total <b id="t1">$—</b></div><div class="tg"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg> Free cancel up to {SITE.cancelFreeHours}h</div></div>
      <div class="bk-actions">
        <button class="btn btn-ghost back" id="back1">Back</button>
        <button class="btn btn-amber" id="toStep2">Review &amp; pay</button>
      </div>
    </div>

    <!-- STEP 3: REVIEW + PAY -->
    <div class="step" id="step2">
      <div class="summary" id="summary"></div>

      <label class="policy">
        <input type="checkbox" id="policy">
        <span>I understand cancellation is free up to {SITE.cancelFreeHours} hours before pickup. Within {SITE.cancelFreeHours} hours, or for a no-show, the booking is non-refundable because the carrier has been committed.</span>
      </label>

      {isLive ? (
        <>
          <label style="font-size:.72rem;letter-spacing:.04em;text-transform:uppercase;color:var(--slate);font-weight:600;margin-bottom:8px;display:block">Pay securely</label>
          <div class="fld cardfield"><label for="cc">Card number</label><input class="ctrl" id="cc" placeholder="1234 5678 9012 3456" inputmode="numeric"></div>
          <div class="pay-row">
            <div class="fld"><label for="exp">Expiry</label><input class="ctrl" id="exp" placeholder="MM / YY"></div>
            <div class="fld"><label for="cvc">CVC</label><input class="ctrl" id="cvc" placeholder="123" inputmode="numeric"></div>
          </div>
        </>
      ) : null}

      <div id="payErr" class="route-hint" style="color:#d9534f;display:none;margin-bottom:10px"></div>
      <div class="bk-actions">
        <button class="btn btn-ghost back" id="back2">Back</button>
        <button class="btn btn-amber" id="payBtn">Pay <span id="payAmt">$—</span> up front</button>
      </div>
      <div class="secure-note">
        <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
        Prepaid in USD{isLive ? '' : ' · Demo mode — no real charge'}
      </div>
      <p class="disclosure">{DISCLOSURE}</p>
    </div>

    <!-- CONFIRMATION -->
    <div class="step" id="step3">
      <div class="confirm">
        <div class="ok"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></div>
        <h3>You're booked!</h3>
        <p>A confirmation and driver details are on the way to your email. We'll track your flight and be waiting at arrivals.</p>
        <div class="ref" id="bref">UIO-000000</div>
        <p class="disclosure" style="text-align:left">{DISCLOSURE}</p>
        <div style="margin-top:18px"><button class="btn btn-outline" id="again">Book another transfer</button></div>
      </div>
    </div>

  </div>

  <script type="application/json" id="ratesData" set:html={widgetData}></script>
</div>

<script>
  import { createCheckout } from '../lib/payments';

  type Zone = { key: string; name: string; sub: string; eta: string; price: number; examples?: string[] };
  type Extras = { childSeat: number; extraStop: number };
  const data = JSON.parse(document.getElementById('ratesData')!.textContent || '{}');
  const ZONES: Zone[] = data.zones;
  const EXTRAS: Extras = data.extras;
  const MIN_LEAD: number = typeof data.minLeadDays === 'number' ? data.minLeadDays : 3;
  const HARD_MAX_PAX = 4;
  const MAX_PAX: number = Math.min(
    typeof data.maxPax === 'number' ? data.maxPax : HARD_MAX_PAX,
    HARD_MAX_PAX,
  );
  const PAX_OVER_MSG = 'This vehicle seats 4 passengers.';
  const VEHNAME: Record<string, string> = Object.fromEntries(
    (data.vehicles as { key: string; name: string }[]).map((v) => [v.key, v.name]),
  );
  const VEH_KEYS = (data.vehicles as { key: string }[]).map((v) => v.key);

  const state = { dir: 'from', zone: '', veh: VEH_KEYS[0], child: 0, stop: false, rt: false, step: 0 };

  const $ = (id: string) => document.getElementById(id)!;
  const zoneSel = $('zone') as HTMLSelectElement;
  const dateEl = $('date') as HTMLInputElement;
  const rdateEl = $('rdate') as HTMLInputElement;
  const dateHint = $('dateHint');
  const paxEl = $('pax') as HTMLSelectElement;
  const paxHint = $('paxHint');

  function localYmd(d: Date) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }
  function addLocalDays(n: number) {
    const d = new Date();
    d.setHours(0, 0, 0, 0);
    d.setDate(d.getDate() + n);
    return d;
  }
  const minPickup = localYmd(addLocalDays(MIN_LEAD));
  const LEAD_COPY = 'We book at least 3 days ahead so your driver is confirmed.';

  function setDateHint(msg: string, err = false) {
    dateHint.textContent = msg;
    dateHint.classList.toggle('is-err', err);
  }
  function paxCount() {
    const n = parseInt(paxEl.value, 10);
    return Number.isFinite(n) ? n : 0;
  }
  function setPaxHint(err: boolean) {
    paxHint.textContent = PAX_OVER_MSG;
    paxHint.classList.toggle('is-err', err);
    paxEl.classList.toggle('field-err', err);
  }
  function paxOk() {
    const n = paxCount();
    return n >= 1 && n <= MAX_PAX;
  }
  // Drop injected options above 4, clamp a too-high value, and surface a clear
  // message if the control somehow went over the SUV passenger limit.
  function enforcePax() {
    const over = paxCount() > MAX_PAX;
    Array.from(paxEl.options).forEach((opt) => {
      const n = parseInt(opt.value, 10);
      if (Number.isFinite(n) && n > MAX_PAX) opt.remove();
    });
    if (over) {
      paxEl.value = String(MAX_PAX);
      setPaxHint(true);
      return false;
    }
    setPaxHint(false);
    return paxOk();
  }
  function applyLeadMin() {
    dateEl.min = minPickup;
    rdateEl.min = dateEl.value && dateEl.value > minPickup ? dateEl.value : minPickup;
  }
  function pickupOk() {
    const v = dateEl.value;
    return !!v && v >= minPickup;
  }
  function clampPickup() {
    if (!dateEl.value || dateEl.value < minPickup) dateEl.value = minPickup;
    applyLeadMin();
    if (rdateEl.value && rdateEl.value < dateEl.value) rdateEl.value = dateEl.value;
  }

  const zone = () => ZONES.find((x) => x.key === state.zone);
  const basePrice = () => zone()?.price ?? null;
  const total = () => {
    const b = basePrice();
    if (b === null) return null;
    let t = b * (state.rt ? 2 : 1);
    t += state.child * EXTRAS.childSeat;
    if (state.stop) t += EXTRAS.extraStop * (state.rt ? 2 : 1);
    return t;
  };
  const money = (n: number | null) => (n === null ? '$—' : '$' + n);

  function setDir(d: string) {
    state.dir = d;
    document.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) =>
      b.classList.toggle('on', b.dataset.dir === d),
    );
    $('zoneLabel').textContent =
      d === 'from' ? 'Drop-off (prepaid luxury SUV)' : 'Pick-up (prepaid luxury SUV)';
    recalc();
  }
  function recalc() {
    state.zone = zoneSel.value;
    state.stop = ($('stop') as HTMLInputElement)?.checked ?? false;
    const z = zone();
    VEH_KEYS.forEach((v) => {
      const el = $('p-' + v);
      if (el) el.textContent = z ? '$' + z.price : '$—';
    });
    const hint = $('etaHint');
    const hotels = $('hotelHint');
    if (!z) {
      hint.textContent = '$50 airport hotel · $75 anywhere in Cumbayá · $100 anywhere in Quito';
      hotels.hidden = true;
      hotels.textContent = '';
    } else {
      hint.textContent = 'Estimated drive time · ' + z.eta;
      hotels.hidden = false;
      hotels.textContent =
        z.key === 'quito'
          ? 'Includes Hyatt, Oro Verde, Swissôtel, Casa Gangotena, and any other city address. A city-center Wyndham (not the airport hotel) is this $100 rate too.'
          : z.key === 'cumbaya'
            ? 'Anywhere in Cumbayá — valley hotels and addresses between the airport and Quito city. Not the $100 city rate.'
            : 'Airport-area hotel in Tababela — not a city-center Wyndham.';
    }
    const t = total();
    ['t0', 't1'].forEach((id) => ($(id).textContent = money(t)));
    $('payAmt').textContent = money(t);
  }

  function showStep(n: number) {
    state.step = n;
    for (let i = 0; i < 4; i++) $('step' + i).classList.toggle('on', i === n);
    for (let i = 0; i < 3; i++) $('dot' + i).classList.toggle('on', i <= Math.min(n, 2));
    const titles = ['Reserve your transfer', 'Add-ons & details', 'Review & pay up front', 'Booking confirmed'];
    $('bkTitle').textContent = titles[n];
    document.querySelector('.booker')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function go(n: number) {
    if (n >= 1 && !state.zone) {
      zoneSel.focus();
      zoneSel.classList.add('field-err');
      return;
    }
    zoneSel.classList.remove('field-err');
    if (n >= 1) {
      if (!enforcePax()) {
        paxEl.focus();
        return;
      }
      clampPickup();
      if (!pickupOk()) {
        dateEl.focus();
        dateEl.classList.add('field-err');
        setDateHint('Pick a date at least 3 days from today so we can confirm your driver.', true);
        return;
      }
      dateEl.classList.remove('field-err');
      setDateHint(LEAD_COPY, false);
    }
    if (n === 2) {
      if (state.rt && rdateEl.value && rdateEl.value < dateEl.value) {
        rdateEl.value = dateEl.value;
      }
      buildSummary();
    }
    showStep(n);
  }

  function buildSummary() {
    const z = zone()!;
    const b = basePrice()!;
    const route = state.dir === 'from' ? 'UIO → ' + z.name : z.name + ' → UIO';
    const d = ($('date') as HTMLInputElement).value;
    const tm = ($('time') as HTMLInputElement).value;
    const rows: [string, string][] = [];
    rows.push(['Route', route]);
    rows.push(['When', (d || 'Date TBC') + (tm ? ' · ' + tm : '')]);
    rows.push([VEHNAME[state.veh] + ' · ' + ($('pax') as HTMLSelectElement).value + ' pax', '$' + b]);
    if (state.rt) {
      const rd = ($('rdate') as HTMLInputElement).value;
      const rtm = ($('rtime') as HTMLInputElement).value;
      rows.push(['Return ride' + (rd ? ' · ' + rd + (rtm ? ' ' + rtm : '') : ''), '$' + b]);
    }
    if (state.child) rows.push(['Child seat × ' + state.child, '$' + state.child * EXTRAS.childSeat]);
    if (state.stop) rows.push(['Extra stop' + (state.rt ? ' × 2' : ''), '$' + EXTRAS.extraStop * (state.rt ? 2 : 1)]);
    rows.push(['Meet & greet + flight tracking', 'Included']);
    let html = rows
      .map((r) => `<div class="sline"><span class="k">${r[0]}</span><span class="v">${r[1]}</span></div>`)
      .join('');
    html += `<div class="sline rt tot"><span class="k">Prepaid total (USD)</span><span class="v">${money(total())}</span></div>`;
    $('summary').innerHTML = html;
  }

  async function pay() {
    const err = $('payErr');
    const name = ($('name') as HTMLInputElement).value.trim();
    const email = ($('email') as HTMLInputElement).value.trim();
    const phone = ($('phone') as HTMLInputElement).value.trim();
    const policy = ($('policy') as HTMLInputElement).checked;
    const show = (m: string) => {
      err.textContent = m;
      err.style.display = 'flex';
    };
    if (!name || !email || !phone) return show('Please add your name, email, and mobile number (step 2).');
    if (!/.+@.+\..+/.test(email)) return show('Please enter a valid email address.');
    if (!policy) return show('Please accept the cancellation policy to continue.');
    clampPickup();
    if (!pickupOk()) {
      showStep(0);
      dateEl.focus();
      dateEl.classList.add('field-err');
      return show('Pickup must be at least 3 days from today so we can confirm your driver.');
    }
    if (!enforcePax()) {
      showStep(0);
      paxEl.focus();
      return show(PAX_OVER_MSG);
    }
    err.style.display = 'none';

    const btn = $('payBtn') as HTMLButtonElement;
    const label = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Processing…';

    const z = zone()!;
    const result = await createCheckout({
      amountUSD: total()!,
      metadata: {
        route: state.dir === 'from' ? 'UIO->' + z.key : z.key + '->UIO',
        vehicle: state.veh,
        pax: ($('pax') as HTMLSelectElement).value,
        date: ($('date') as HTMLInputElement).value,
        time: ($('time') as HTMLInputElement).value,
        roundTrip: state.rt,
        childSeats: state.child,
        extraStop: state.stop,
        flight: ($('flight') as HTMLInputElement).value.trim(),
        name,
        email,
        phone,
        cancellationAccepted: true,
      },
    });

    if (!result.ok) {
      btn.disabled = false;
      btn.innerHTML = label;
      return show(result.error || 'Payment could not be started. Please try again.');
    }
    if (result.checkoutUrl) {
      window.location.href = result.checkoutUrl; // live → hosted checkout
      return;
    }
    $('bref').textContent = result.reference;
    btn.disabled = false;
    btn.innerHTML = label;
    showStep(3);
  }

  function reset() {
    state.child = 0;
    state.stop = false;
    state.rt = false;
    $('childN').textContent = '0';
    const rt = $('rt') as HTMLInputElement;
    if (rt) {
      rt.checked = false;
      $('rtFields').style.display = 'none';
    }
    const stop = $('stop') as HTMLInputElement;
    if (stop) stop.checked = false;
    const policy = $('policy') as HTMLInputElement;
    if (policy) policy.checked = false;
    recalc();
    showStep(0);
  }

  // ── wire up ────────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) =>
    b.addEventListener('click', () => setDir(b.dataset.dir!)),
  );
  zoneSel.addEventListener('change', recalc);
  paxEl.addEventListener('change', () => {
    enforcePax();
    recalc();
  });
  dateEl.addEventListener('change', () => {
    clampPickup();
    dateEl.classList.remove('field-err');
    setDateHint(LEAD_COPY, false);
  });
  dateEl.addEventListener('blur', clampPickup);
  rdateEl.addEventListener('change', () => {
    if (rdateEl.value && rdateEl.value < dateEl.value) rdateEl.value = dateEl.value;
  });
  $('toStep1').addEventListener('click', () => go(1));
  $('back1').addEventListener('click', () => go(0));
  $('toStep2').addEventListener('click', () => go(2));
  $('back2').addEventListener('click', () => go(1));
  $('payBtn').addEventListener('click', pay);
  $('again').addEventListener('click', reset);
  $('childMinus').addEventListener('click', () => {
    state.child = Math.max(0, state.child - 1);
    $('childN').textContent = String(state.child);
    recalc();
  });
  $('childPlus').addEventListener('click', () => {
    state.child = Math.min(3, state.child + 1);
    $('childN').textContent = String(state.child);
    recalc();
  });
  $('rt').addEventListener('change', () => {
    state.rt = ($('rt') as HTMLInputElement).checked;
    $('rtFields').style.display = state.rt ? 'block' : 'none';
    recalc();
  });
  $('stop').addEventListener('change', recalc);

  // Live card-field niceties (only present in live mode).
  const cc = $('cc') as HTMLInputElement | null;
  cc?.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    t.value = t.value.replace(/\D/g, '').slice(0, 16).replace(/(.{4})/g, '$1 ').trim();
  });
  const exp = $('exp') as HTMLInputElement | null;
  exp?.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    let v = t.value.replace(/\D/g, '').slice(0, 4);
    if (v.length > 2) v = v.slice(0, 2) + ' / ' + v.slice(2);
    t.value = v;
  });

  // Default pickup = first bookable day (today + 3 calendar days). Native
  // min greys out today and the next 2 days in the date picker.
  applyLeadMin();
  const qsDate = new URLSearchParams(location.search).get('date');
  dateEl.value = qsDate && qsDate >= minPickup ? qsDate : minPickup;
  clampPickup();
  setDateHint(LEAD_COPY, false);
  enforcePax();

  // Global prefill hook (used by the rates table + deep-links).
  (window as any).andesPrefill = (key: string) => {
    zoneSel.value = key;
    recalc();
    $('book').scrollIntoView({ behavior: 'smooth', block: 'center' });
  };
  // Deep-link: /?zone=quito#book preselects the zone.
  const qsZone = new URLSearchParams(location.search).get('zone');
  if (qsZone && ZONES.some((z) => z.key === qsZone)) {
    zoneSel.value = qsZone;
  }

  recalc();
</script>
