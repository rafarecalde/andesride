---
import { SITE, DISCLOSURE } from '../config';
const year = new Date().getFullYear();
const waLink = `https://wa.me/${SITE.whatsapp.replace(/[^0-9]/g, '')}`;
---
<footer class="site" id="contact">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="name">{SITE.name} <span>Quito Airport Transfers · UIO</span></div>
        <p>Private, flat-rate airport transfers to and from Mariscal Sucre International Airport (UIO), Quito, Ecuador.</p>
        <p class="foot-disc">{DISCLOSURE}</p>
      </div>
      <div class="foot-col">
        <h4>Transfers</h4>
        <a href="/#book">Book a transfer</a>
        <a href="/#rates">Flat rates</a>
        <a href="/#fleet">Our fleet</a>
        <a href="/guide">Travel guide</a>
        <a href="/#faq">FAQ</a>
      </div>
      <div class="foot-col">
        <h4>Popular routes</h4>
        <a href="/quito-airport-to-norte">UIO → Quito Norte</a>
        <a href="/quito-airport-to-cumbaya">UIO → Cumbayá</a>
        <a href="/quito-airport-to-mitad">UIO → Mitad del Mundo</a>
        <a href="/quito-airport-to-otavalo">UIO → Otavalo</a>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <span class="li"><b>WhatsApp</b><br><a href={waLink} target="_blank" rel="noopener">{SITE.whatsapp}</a></span>
        <span class="li"><b>Email</b><br><a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} {SITE.name}. All prices in USD.</span>
      <span>
        <a href="/terms">Terms</a> ·
        <a href="/privacy">Privacy</a> ·
        <a href="/cancellation">Cancellation policy</a>
      </span>
    </div>
  </div>
</footer>
