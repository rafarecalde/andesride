---
import { SITE, DISCLOSURE } from '../config';
import { u } from '../lib/url';
const year = new Date().getFullYear();
const waLink = `https://wa.me/${SITE.whatsapp.replace(/[^0-9]/g, '')}`;
---
<footer class="site" id="contact">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="name">{SITE.name} <span>{SITE.descriptor}</span></div>
        <p>Prepaid luxury-SUV airport transfers to and from Mariscal Sucre International Airport (UIO), Quito, Ecuador.</p>
        <p class="foot-disc">{DISCLOSURE}</p>
      </div>
      <div class="foot-col">
        <h4>Transfers</h4>
        <a href={u('/#book')}>Book a transfer</a>
        <a href={u('/#rates')}>Flat rates</a>
        <a href={u('/#fleet')}>Our fleet</a>
        <a href={u('/guide')}>Travel guide</a>
        <a href={u('/#faq')}>FAQ</a>
      </div>
      <div class="foot-col">
        <h4>Prepaid routes</h4>
        <a href={u('/quito-airport-to-wyndham-airport')}>UIO → Wyndham Quito Airport · $50</a>
        <a href={u('/quito-airport-to-quito')}>UIO → anywhere in Quito · $100</a>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <span class="li"><b>WhatsApp</b><br><a href={waLink} target="_blank" rel="noopener">{SITE.whatsapp}</a></span>
        {SITE.email ? (
          <span class="li"><b>Email</b><br><a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
        ) : null}
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} {SITE.name}. All prices in USD.</span>
      <span>
        <a href={u('/terms')}>Terms</a> ·
        <a href={u('/privacy')}>Privacy</a> ·
        <a href={u('/cancellation')}>Cancellation policy</a>
      </span>
    </div>
  </div>
</footer>
