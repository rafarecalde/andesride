---
import { SITE, hasPhone } from '../config';
const telLink = hasPhone ? `tel:${SITE.phone.replace(/[^0-9+]/g, '')}` : '';
---
<div class="topbar">
  <div class="wrap">
    <div class="tb-l">
      <span class="pill">Prepaid luxury SUV</span>
      $50 airport hotel · $75 anywhere in Cumbayá · $100 anywhere in Quito · USD
    </div>
    <div class="tb-r">
      {SITE.email ? (
        <a href={`mailto:${SITE.email}`}>
          <svg viewBox="0 0 24 24"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>{SITE.email}
        </a>
      ) : null}
      {hasPhone ? (
        <a href={telLink}>
          <svg viewBox="0 0 24 24"><path d="M4 5h3l2 5-2 1a12 12 0 006 6l1-2 5 2v3a2 2 0 01-2 2A16 16 0 014 7a2 2 0 010-2z"/></svg>{SITE.phone}
        </a>
      ) : null}
    </div>
  </div>
</div>
