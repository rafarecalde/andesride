---
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: 'website' | 'article';
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, path, ogType, image, schema } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} path={path} ogType={ogType} image={image} />
    {schema && <JsonLd schema={schema} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <TopBar />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll-reveal — respects prefers-reduced-motion.
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12 },
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      }
    </script>
    <script>
      // Optional click hook. Calls Plausible or gtag only when one is already on the page.
      const root = window as Window & {
        __uioAffiliateClicks?: boolean;
        plausible?: (name: string, options?: { props: Record<string, string> }) => void;
        gtag?: (...args: unknown[]) => void;
      };
      if (!root.__uioAffiliateClicks) {
        root.__uioAffiliateClicks = true;
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('[data-affiliate]');
          if (!link) return;
          const partner = link.getAttribute('data-affiliate') || '';
          const label = link.getAttribute('data-affiliate-label') || '';
          if (typeof root.plausible === 'function') {
            root.plausible('Affiliate', { props: { partner, label } });
          }
          if (typeof root.gtag === 'function') {
            root.gtag('event', 'affiliate_click', { partner, label });
          }
        });
      }
    </script>
  </body>
</html>
