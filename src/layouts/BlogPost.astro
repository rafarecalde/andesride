---
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import BookingCta from '../components/BookingCta.astro';
import LuxuryStays from '../components/LuxuryStays.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import TripPlan from '../components/TripPlan.astro';
import { getPhoto } from '../lib/photos';
import { AFFILIATE_DISCLOSURE, luxuryIdsForPost } from '../config/affiliates';
import { SITE } from '../config';
import { u } from '../lib/url';
import { publicUrl } from '../lib/publicUrl';
import rates from '../data/rates.json';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, category, publishDate, updatedDate, tags, ctaZone } = post.data;

// When a post names a zone, deep-link its CTA to that route with the prepaid price.
const zone = ctaZone ? rates.zones.find((z) => z.key === ctaZone) : undefined;
const ctaProps = zone
  ? {
      zone: zone.key,
      heading: `Book your UIO ↔ ${zone.name} transfer`,
      text: `Prepaid luxury SUV · $${zone.price} USD · about ${zone.eta}. Flight tracking and meet & greet included. Free cancellation up to ${SITE.cancelFreeHours} hours before.`,
    }
  : {};
const path = `/guide/${post.slug}`;
const photo = post.data.heroImage ? getPhoto(post.data.heroImage) : undefined;
const luxuryIds = luxuryIdsForPost(post.slug);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  about: category,
  keywords: tags.join(', '),
  datePublished: publishDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  mainEntityOfPage: publicUrl(path, Astro.site),
  ...(photo ? { image: publicUrl(photo.src.src, Astro.site) } : {}),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
};
---
<BaseLayout title={`${title} | ${SITE.name}`} description={description} path={path} ogType="article" image={photo?.src.src} schema={articleSchema}>
  <article>
    <header class="page-hero">
      <div class="wrap">
        <div class="crumbs"><a href={u('/')}>Home</a> · <a href={u('/guide')}>Travel guide</a></div>
        <span class="eyebrow">{category}</span>
        <h1>{title}</h1>
        <div class="meta">
          {fmt(publishDate)}{updatedDate ? ` · Updated ${fmt(updatedDate)}` : ''}
        </div>
      </div>
    </header>
    <div class="wrap">
      {photo && (
        <figure class="article-hero">
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={['avif', 'webp']}
            quality={68}
            widths={[640, 960, 1400]}
            sizes="(min-width: 900px) 920px, 100vw"
            loading="eager"
          />
          <figcaption><PhotoCredit id={photo.id} /></figcaption>
        </figure>
      )}
      <div class="prose">
        <slot />
      </div>
      <div class="post-extras">
        {luxuryIds.length > 0 && <LuxuryStays ids={luxuryIds} embedded />}
        <h2 class="post-plan-title">Plan your trip</h2>
        <TripPlan variant="post" slug={post.slug} embedded />
        <p class="aff-note">{AFFILIATE_DISCLOSURE} <a href={u('/disclosure')}>Affiliate disclosure</a></p>
      </div>
      <BookingCta {...ctaProps} />
    </div>
  </article>
</BaseLayout>
