---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import HowFar from '../components/HowFar.astro';
import Rates from '../components/Rates.astro';
import LandingLate from '../components/LandingLate.astro';
import Why from '../components/Why.astro';
import Fleet from '../components/Fleet.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, hasPhone } from '../config';
import { u } from '../lib/url';
import { publicUrl } from '../lib/publicUrl';
import { FAQ } from '../data/faq';
import rates from '../data/rates.json';

const latest = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const prices = rates.zones.map((z) => z.price);
const low = Math.min(...prices);
const high = Math.max(...prices);
const origin = publicUrl('/', Astro.site);

const taxiSchema = {
  '@context': 'https://schema.org',
  '@type': ['TaxiService', 'LocalBusiness'],
  name: SITE.name,
  url: origin,
  description: SITE.tagline,
  ...(hasPhone ? { telephone: SITE.phone } : {}),
  ...(SITE.email ? { email: SITE.email } : {}),
  areaServed: { '@type': 'City', name: 'Quito, Ecuador' },
  priceRange: `$${low}–$${high} USD`,
  currenciesAccepted: 'USD',
  provider: { '@type': 'Organization', name: SITE.name, url: origin },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Quito airport (UIO) prepaid luxury-SUV transfers',
    itemListElement: rates.zones.map((z) => ({
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: z.price,
      itemOffered: {
        '@type': 'Service',
        name: `Prepaid luxury SUV: UIO ↔ ${z.name}`,
        serviceType: 'Airport transfer',
        description: z.examples?.length
          ? `Includes ${z.examples.join(', ')}`
          : undefined,
      },
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title={`${SITE.name} | Prepaid luxury SUV from UIO`}
  description="Prepaid luxury-SUV airport transfers from Quito (UIO). $50 to Wyndham Quito Airport, $75 anywhere in Cumbayá, $100 anywhere in Quito city — Hyatt, Oro Verde, Swissôtel, Casa Gangotena. Licensed driver, pay up front."
  path="/"
  schema={[taxiSchema, faqSchema]}
>
  <Hero />
  <Reviews />
  <HowItWorks />
  <HowFar />
  <Rates />
  <LandingLate />
  <Why />
  <Fleet />

  <section id="guide-latest">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">Travel guide</span><h2 class="section-title">Plan a smooth arrival in Quito</h2></div>
      <div class="post-grid">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
      <div style="text-align:center;margin-top:32px"><a href={u('/guide')} class="btn btn-outline">Read all guides</a></div>
    </div>
  </section>

  <Faq />
  <Cta />
</BaseLayout>
