---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Rates from '../components/Rates.astro';
import Why from '../components/Why.astro';
import Fleet from '../components/Fleet.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
import { u } from '../lib/url';
import { FAQ } from '../data/faq';
import rates from '../data/rates.json';

const latest = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const prices = rates.zones.flatMap((z) => [z.sedan, z.suv, z.van]);
const low = Math.min(...prices);
const high = Math.max(...prices);

const taxiSchema = {
  '@context': 'https://schema.org',
  '@type': ['TaxiService', 'LocalBusiness'],
  name: SITE.name,
  url: SITE.domain,
  description: SITE.tagline,
  telephone: SITE.phone,
  email: SITE.email,
  areaServed: { '@type': 'City', name: 'Quito, Ecuador' },
  priceRange: `$${low}–$${high} USD`,
  currenciesAccepted: 'USD',
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: SITE.ratingValue,
    reviewCount: SITE.ratingCount,
    bestRating: '5',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Quito airport (UIO) flat-rate transfers',
    itemListElement: rates.zones.map((z) => ({
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: z.sedan,
      itemOffered: {
        '@type': 'Service',
        name: `Private transfer: UIO ↔ ${z.name}`,
        serviceType: 'Airport transfer',
      },
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title={`${SITE.name} — Quito Airport Transfers (UIO) | Flat-Rate Private Rides`}
  description="Private, flat-rate airport transfers to and from Quito (UIO). Fixed USD price, flight tracking, meet & greet, and licensed English-speaking drivers. Book online."
  path="/"
  schema={[taxiSchema, faqSchema]}
>
  <Hero />
  <HowItWorks />
  <Rates />
  <Why />
  <Fleet />
  <Reviews />

  <section id="guide-latest">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow">Travel guide</span><h2 class="section-title">Plan a smooth arrival in Quito</h2></div>
      <div class="post-grid">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
      <div style="text-align:center;margin-top:32px"><a href={u('/guide')} class="btn btn-outline">Read all guides</a></div>
    </div>
  </section>

  <Faq />
  <Cta />
</BaseLayout>
