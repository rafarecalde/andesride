---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AFFILIATE_DISCLOSURE } from '../config/affiliates';
import { SITE } from '../config';
import { u } from '../lib/url';
---
<BaseLayout
  title={`Affiliate disclosure | ${SITE.name}`}
  description="Some links on Quito Airport Transfer are affiliate links. Booking through them may earn us a commission at no extra cost to you."
  path="/disclosure"
>
  <header class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Legal</span>
      <h1>Affiliate disclosure</h1>
    </div>
  </header>
  <div class="wrap">
    <div class="prose">
      <p>{AFFILIATE_DISCLOSURE}</p>
      <p>
        Guides on this site sometimes link to tours, hotels, car rental, and travel eSIMs
        (including GetYourGuide, Viator, Klook, Economybookings, Booking.com, and Airalo).
        If you book through one of those links, we may earn a commission. The price you pay
        is the partner’s price. Our airport-transfer booking is separate and is not part of
        those programs.
      </p>
      <p>
        This site uses a Travelpayouts script that may convert some outbound travel links
        into affiliate links.
      </p>
      <h2>Photo credits</h2>
      <p>
        Lodge cards use scenery of the area — a valley, a volcano, or the historic center —
        rather than a photograph of a different hotel. The airport card uses our own terminal photo.
        Every photograph, the author, and the license are listed on the <a href={u('/credits')}>photo credits</a> page.
      </p>
    </div>
  </div>
</BaseLayout>
