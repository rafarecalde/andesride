---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { u } from '../lib/url';
---
<BaseLayout title={`Privacy Policy | ${SITE.name}`} description="Quito Airport Transfer privacy policy." path="/privacy">
  <header class="page-hero"><div class="wrap"><span class="eyebrow">Legal</span><h1>Privacy policy</h1></div></header>
  <div class="wrap"><div class="prose">
    <p><em>Template — have local counsel review before launch.</em></p>
    <h2>What we collect</h2>
    <p>To fulfil a booking we collect the details you enter: pickup name, email, mobile number, flight number, hotel or address, passenger count, trip notes, route, date/time, vehicle, and the add-ons you select. Payment is processed by our payment provider; we do not store full card numbers.</p>
    <h2>How we use it</h2>
    <p>We use your information to confirm and deliver your transfer, to coordinate the assigned carrier, to track your flight, and to contact you about your booking. We share only what's necessary with the carrier providing your ride.</p>
    <h2>Payment processing</h2>
    <p>Card payments are handled by a third-party payment processor under their own terms and security standards. {SITE.name} receives a confirmation and booking metadata, not your card details.</p>
    <h2>Your choices</h2>
    <p>To access, correct, or delete your information, {SITE.email ? `contact ${SITE.email}` : 'reply to your booking confirmation'}.</p>
    <h2>Affiliate links</h2>
    <p>Some pages link to tours, hotels, car rental, and travel eSIMs. We may earn a commission if you book through these links, at no extra cost to you. See the <a href={u('/disclosure')}>affiliate disclosure</a>.</p>
    <h2>Analytics &amp; cookies</h2>
    <p>If analytics are enabled, this section will describe what is collected and how to opt out. Add your analytics/cookie disclosure here before launch.</p>
    <h2>Contact</h2>
    <p>{SITE.email || 'Reply to your booking confirmation.'}</p>
  </div></div>
</BaseLayout>
