# ── Quito Airport Transfer payment/notification function env (set in the
#    platform secret store, NEVER commit real values). Used only by the
#    serverless function in /functions — the static site holds no secrets.

# Stripe (recommended via a US entity — Stripe doesn't operate in Ecuador)
# Put these with `npx wrangler secret put …` from /functions — not in wrangler.toml.
# Use sk_test_ / test-mode whsec_ until you are ready to charge real cards.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Redirect URLs — wrangler.toml [vars] already ships these defaults
SUCCESS_URL=https://uiotransfers.com/success
CANCEL_URL=https://uiotransfers.com/#book

# Notifications
OPERATOR_EMAIL=operator@uiotransfers.com
EMAIL_API_KEY=xxx                      # Resend / Postmark / SES key
BOOKINGS_SHEET_WEBHOOK=https://...      # Google Sheet / Airtable append endpoint

# CORS — the origin allowed to call the function
ALLOWED_ORIGIN=https://uiotransfers.com
